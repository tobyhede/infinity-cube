{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["react", "react-dom"],
    // The boundary: see `packages/core/tsconfig.json`. `ui` is reusable,
    // presentation-agnostic React over the domain vocabulary — `core` only. Not
    // `graph`, which would put domain logic behind a component; not the render
    // libraries, which belong to the adapter. (No `rootDir` — see `graph`.)
    "paths": {
      "@project/core": ["../core/src/index.ts"],
      "@project/plugin-ur/domain": ["../plugin-ur/src/domain.ts"],
      "@project/resource-api/domain": ["../resource-api/src/domain/index.ts"],
      "@project/plugin-ur/view": ["../plugin-ur/src/view.tsx"],
      "@project/resource-api/view": ["../resource-api/src/view/index.tsx"]
    }
  },
  "include": ["src"]
}
