{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The boundary: see `packages/core/tsconfig.json`. `graph` is pure logic
    // over a Space — `core` and nothing else, no React, no render library.
    //
    // No `rootDir` here: it would reject the legitimate `@project/core` import
    // too, since the referenced file resolves outside this package. `rootDir` only
    // works for a package with no dependencies. The relative-escape half of the
    // boundary is an ESLint pattern instead.
    "paths": {
      "@project/core": ["../core/src/index.ts"],
      "@project/plugin-default/domain": ["../plugin-default/src/domain.ts"],
      "@project/plugin-image/domain": ["../plugin-image/src/domain.ts"],
      "@project/plugin-ur/domain": ["../plugin-ur/src/domain.ts"],
      "@project/plugin-markdown/domain": ["../plugin-markdown/src/domain.ts"],
      "@project/plugin-reference/domain": ["../plugin-reference/src/domain.ts"],
      "@project/plugin-space/domain": ["../plugin-space/src/domain.ts"],
      "@project/resource-api/domain": ["../resource-api/src/domain/index.ts"]
    }
  },
  "include": ["src"]
}
