{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["react", "react-dom"],
    // The build's plugin list (ADR 0142): the one package that imports a
    // plugin. It reaches each plugin's two halves and the Resource API, and
    // nothing else of ours. (No `rootDir` — see `graph`.)
    "paths": {
      "@project/plugin-default/domain": ["../plugin-default/src/domain.ts"],
      "@project/plugin-default/view": ["../plugin-default/src/view.tsx"],
      "@project/plugin-image/domain": ["../plugin-image/src/domain.ts"],
      "@project/plugin-image/view": ["../plugin-image/src/view.tsx"],
      "@project/plugin-markdown/domain": ["../plugin-markdown/src/domain.ts"],
      "@project/plugin-markdown/view": ["../plugin-markdown/src/view.tsx"],
      "@project/plugin-reference/domain": ["../plugin-reference/src/domain.ts"],
      "@project/plugin-reference/view": ["../plugin-reference/src/view.tsx"],
      "@project/plugin-space/domain": ["../plugin-space/src/domain.ts"],
      "@project/plugin-space/view": ["../plugin-space/src/view.tsx"],
      "@project/plugin-ur/domain": ["../plugin-ur/src/domain.ts"],
      "@project/plugin-ur/view": ["../plugin-ur/src/view.tsx"],
      "@project/resource-api/domain": ["../resource-api/src/domain/index.ts"],
      "@project/resource-api/view": ["../resource-api/src/view/index.tsx"]
    }
  },
  "include": ["src"]
}
