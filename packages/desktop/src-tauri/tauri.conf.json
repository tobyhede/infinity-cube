{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InfinityCube",
  "identifier": "dev.infinitycube.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "home",
        "title": "InfinityCube",
        "url": "index.html",
        "width": 520,
        "height": 340,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../app/dist/": "app/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4Nzc1NjU2NzBCMDgwQkYKUldTL2dMQndWbFozZU11UTZ5V0J4S3lhc3o3Vk9rN1EraHRhTUdKdUZKbGcrWlA0OEhBSFFuMlkK",
      "endpoints": [
        "https://github.com/tobyhede/infinity-cube/releases/download/desktop-updates/latest.json"
      ]
    }
  }
}
