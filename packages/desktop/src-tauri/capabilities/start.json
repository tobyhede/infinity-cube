{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "start",
  "description": "The Start window (Storage ST-131) may call its own commands, and nothing else.",
  "windows": ["start"],
  "permissions": [
    "allow-start-browse",
    "allow-start-close",
    "allow-start-connect-postgres",
    "allow-start-create-space",
    "allow-start-open-folder",
    "allow-start-open-recent",
    "allow-start-open-sqlite-file",
    "allow-start-window-view"
  ]
}
