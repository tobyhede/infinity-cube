{
  "name": "graph-native-presentations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=26.8.1"
  },
  "scripts": {
    "dev": "pnpm --filter @project/app dev",
    "dev:fixture": "pnpm --filter @project/app dev:fixture",
    "dev:new": "pnpm --filter @project/app dev:new",
    "dev:roadmap": "pnpm roadmap:space && pnpm --filter @project/app dev:roadmap",
    "ladle": "pnpm --filter @project/app ladle",
    "ladle:build": "pnpm --filter @project/app ladle:build",
    "chrome:cdp": "tsx scripts/launch-chrome-cdp.ts",
    "prebuild": "pnpm contract:emit",
    "build": "pnpm --filter @project/app build",
    "build:mount": "pnpm --filter @project/app build:mount",
    "release:build": "sh release/build.sh",
    "http-server:build": "pnpm --filter @project/app http-server:build",
    "desktop-sidecar:build": "pnpm --filter @project/app desktop-sidecar:build",
    "contract:emit": "prisma-next contract emit",
    "contract:check": "pnpm contract:emit && git diff --exit-code -- src/prisma/contract.json src/prisma/contract.d.ts && prisma-next migration check --format json",
    "contract:emit:sqlite": "prisma-next contract emit --config prisma-next.config.sqlite.ts",
    "contract:check:sqlite": "pnpm contract:emit:sqlite && git diff --exit-code -- src/sqlite/contract.json src/sqlite/contract.d.ts && prisma-next migration check --config prisma-next.config.sqlite.ts --format json",
    "db:migrate": "prisma-next migrate",
    "db:migrate:sqlite": "prisma-next migrate --config prisma-next.config.sqlite.ts",
    "infinity-cube": "exec node --disable-warning=DEP0205 --import tsx src/cli/entry.ts",
    "cube": "exec node --disable-warning=DEP0205 --import tsx src/cli/entry.ts",
    "postgres:up": "docker compose up -d --wait",
    "postgres:down": "docker compose down",
    "typecheck:toolchain": "tsx scripts/check-typescript-toolchain.ts",
    "toolchain:rust:check": "tsx scripts/check-rust-toolchain.ts",
    "toolchain:rust:stale": "tsx scripts/check-rust-toolchain.ts --stale",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:packages": "pnpm -r typecheck",
    "lint": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js . --max-warnings=0 --prune-suppressions",
    "lint:anti-slop": "oxlint -c .oxlintrc.json .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "crap:ts": "tsx scripts/crap.ts",
    "crap:rust": "pnpm crap:rust:coverage && pnpm crap:rust:report --fail-above",
    "crap:rust:coverage": "cargo llvm-cov nextest -p intake -p host -p http-conformance -p infinity-cube --locked --lcov --output-path target/rust-lcov.info",
    "crap:rust:coverage:postgres": "cargo llvm-cov nextest -p intake -p host -p http-conformance -p infinity-cube --locked --run-ignored all -E 'not binary(=shared_migrations)' --lcov --output-path target/rust-lcov.info",
    "crap:rust:report": "cargo crap -p intake -p host -p infinity-cube --lcov target/rust-lcov.info",
    "mutate:session": "stryker run --mutate packages/persistence/src/session.ts --testFiles packages/persistence/test/session.test.ts",
    "mutate:graph": "stryker run --mutate packages/graph/src/space.ts --testFiles packages/graph/test/space-intake.test.ts,packages/graph/test/space.test.ts,packages/graph/test/space.property.test.ts,packages/graph/test/graph.property.test.ts,packages/graph/test/space-snapshot.test.ts",
    "e2e": "playwright test",
    "e2e:fixture": "playwright test --project=chromium",
    "e2e:ladle": "playwright test --config playwright.ladle.config.ts",
    "e2e:mount": "playwright test --config playwright.mount.config.ts",
    "roadmap": "tsx scripts/roadmap.ts",
    "roadmap:html": "tsx scripts/roadmap.ts --html --open",
    "roadmap:space": "tsx scripts/roadmap.ts --space",
    "ui:catalog": "tsx scripts/ui-catalog.ts",
    "ui:catalog:check": "tsx scripts/ui-catalog.ts --check",
    "e2e:postgres": "playwright test --config playwright.postgres.config.ts",
    "e2e:sqlite": "playwright test --config playwright.sqlite.config.ts",
    "test:integration:postgres": "pnpm contract:emit && pnpm db:migrate && vitest run --config vitest.integration.config.ts",
    "test:integration:sqlite": "pnpm contract:emit:sqlite && pnpm db:migrate:sqlite && vitest run --config vitest.sqlite.config.ts",
    "dev:sqlite": "tsx scripts/dev-sqlite.ts",
    "verify:static": "pnpm typecheck:toolchain && pnpm typecheck && pnpm typecheck:packages && pnpm ui:catalog:check && pnpm lint && pnpm lint:anti-slop && pnpm format:check",
    "verify": "pnpm verify:static && pnpm test:coverage && pnpm crap:ts",
    "verify:local": "pnpm verify:static && pnpm test:coverage --maxWorkers=2 --minWorkers=1 && pnpm crap:ts"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.3"
    },
    "patchedDependencies": {
      "@ladle/react@5.1.1": "patches/@ladle__react@5.1.1.patch"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oxlint/plugins": "1.78.0",
    "@playwright/test": "^1.49.1",
    "@prisma-next/adapter-postgres": "0.16.0",
    "@prisma-next/adapter-sqlite": "0.16.0",
    "@prisma-next/contract": "0.16.0",
    "@prisma-next/sql-contract": "0.16.0",
    "@prisma-next/target-postgres": "0.16.0",
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.13.3",
    "@types/pg": "8.21.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript/typescript7": "npm:typescript@^7.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "ajv": "^8.20.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-check": "^3.23.1",
    "globals": "^17.7.0",
    "jsdom": "^25.0.1",
    "oxlint": "1.78.0",
    "pg": "8.22.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma-next": "0.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "4.20.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wrangler": "4.147.0"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@prisma-next/postgres": "0.16.0",
    "@prisma-next/sqlite": "0.16.0",
    "dotenv": "^17.4.2",
    "zod": "^3.25.76"
  }
}
