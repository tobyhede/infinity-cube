{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2025", "ESNext.TypedArrays", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolvePackageJsonImports": true,
    // Every file is a module. Left on `auto`, a file with no import or export is
    // a global script and leaks its declarations repo-wide. No file is one
    // today, which is exactly when this is free to turn on.
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": [],
    // Nothing here emits — `tsc` is a checker in this repo and Vite does the
    // building. Was repeated in all six configs that extend this one.
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noUncheckedSideEffectImports": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@project/aggregate": ["./packages/aggregate/src/index.ts"],
      "@project/core": ["./packages/core/src/index.ts"],
      "@project/graph": ["./packages/graph/src/index.ts"],
      "@project/http": ["./packages/http/src/index.ts"],
      "@project/persistence": ["./packages/persistence/src/index.ts"],
      "@project/persistence/test-support": ["./packages/persistence/test/backend-contract.ts"],
      "@project/plugins/domain": ["./packages/plugins/src/domain.ts"],
      "@project/plugins/view": ["./packages/plugins/src/view.ts"],
      "@project/plugins/testing": ["./packages/plugins/src/testing.ts"],
      "@project/plugin-default/domain": ["./packages/plugin-default/src/domain.ts"],
      "@project/plugin-image/domain": ["./packages/plugin-image/src/domain.ts"],
      "@project/plugin-default/view": ["./packages/plugin-default/src/view.tsx"],
      "@project/plugin-image/view": ["./packages/plugin-image/src/view.tsx"],
      "@project/plugin-markdown/domain": ["./packages/plugin-markdown/src/domain.ts"],
      "@project/plugin-reference/domain": ["./packages/plugin-reference/src/domain.ts"],
      "@project/plugin-space/domain": ["./packages/plugin-space/src/domain.ts"],
      "@project/plugin-markdown/view": ["./packages/plugin-markdown/src/view.tsx"],
      "@project/plugin-reference/view": ["./packages/plugin-reference/src/view.tsx"],
      "@project/plugin-space/view": ["./packages/plugin-space/src/view.tsx"],
      "@project/plugin-ur/domain": ["./packages/plugin-ur/src/domain.ts"],
      "@project/plugin-ur/view": ["./packages/plugin-ur/src/view.tsx"],
      "@project/react-flow-adapter": ["./packages/react-flow-adapter/src/index.ts"],
      "@project/resource-api/domain": ["./packages/resource-api/src/domain/index.ts"],
      "@project/resource-api/view": ["./packages/resource-api/src/view/index.tsx"],
      "@project/resource-api/view/testing": ["./packages/resource-api/src/view/testing.tsx"],
      "@project/resource-api/view/host": ["./packages/resource-api/src/view/host.tsx"],
      "@project/ui": ["./packages/ui/src/index.ts"],
      "@project/ui/MarkdownSourceEditor": ["./packages/ui/src/MarkdownSourceEditor.tsx"]
    }
  }
}
